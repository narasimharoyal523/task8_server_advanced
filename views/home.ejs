<!DOCTYPE html>
<html>
<head>
  <title>Task 8: Advanced Server</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
  <h2>Server-Side Caching Example</h2>
  <p>Current Time: <strong><%= time %></strong></p>
  <% if (fromCache) { %>
    <p class="text-success">Loaded from cache ✅</p>
  <% } else { %>
    <p class="text-warning">Freshly rendered ⏳</p>
  <% } %>

  <hr>

  <h3>Simulate Background Email Job</h3>
  <form method="POST" action="/send-email">
    <input class="form-control mb-2" name="email" placeholder="Enter email" required />
    <button type="submit" class="btn btn-primary">Send Email</button>
  </form>
</body>
</html>
